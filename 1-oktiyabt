<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1-Oktabr — O'qituvchi va Murabbiylar Kuni Muborak!</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }
        .handwriting {
            font-family: 'Caveat', cursive;
        }

        .card-transition {
            transition: all 0.4s ease-in-out;
        }
    </style>
</head>
<body class="p-4 md:p-8 flex flex-col justify-between min-h-screen text-gray-800">

    <header class="text-center max-w-2xl mx-auto my-4">
        <span class="inline-block px-4 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold mb-2">
            🎈 1-Oktabr — Ustoz va Murabbiylar Kuni
        </span>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
            Aziz va Muhtaram Ustozim!
        </h1>
        <p class="text-gray-600 mt-2 text-sm md:text-base">
            Siz uchun tayyorlangan ushbu kamtarona va samimiy dildagi tilaklarni qabul qiling.
        </p>
    </header>

    <main class="max-w-xl mx-auto w-full bg-white rounded-2xl shadow-xl p-6 md:p-8 my-auto relative border border-indigo-50">
        
        <div id="selection-screen" class="text-center py-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Kimga tabrik yo'llamoqchisiz?</h2>
            <p class="text-sm text-gray-500 mb-8">Kimni tabriklashimizga qarab samimiy va mos so'zlar tanlanadi ❤️</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <button onclick="selectGender('male')" class="flex flex-col items-center justify-center p-6 border-2 border-indigo-200 rounded-xl hover:border-indigo-500 hover:bg-indigo-50 transition active:scale-95 group">
                    <span class="text-5xl mb-3 transform group-hover:scale-110 transition">👨‍🏫</span>
                    <span class="text-lg font-bold text-indigo-900">Erkak Ustoz uchun</span>
                    <span class="text-xs text-gray-500 mt-1">Muhtaram va Sabotli ustozimizga</span>
                </button>

                <button onclick="selectGender('female')" class="flex flex-col items-center justify-center p-6 border-2 border-pink-200 rounded-xl hover:border-pink-500 hover:bg-pink-50 transition active:scale-95 group">
                    <span class="text-5xl mb-3 transform group-hover:scale-110 transition">👩‍🏫</span>
                    <span class="text-lg font-bold text-pink-900">Ayol Ustoz uchun</span>
                    <span class="text-xs text-gray-500 mt-1">Mehribon va Jonkuyar ustozimizga</span>
                </button>
            </div>
        </div>

        <div id="card-screen" class="hidden">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
                <button onclick="resetApp()" class="text-xs text-gray-400 hover:text-indigo-600 flex items-center gap-1">
                    <i class="fa-solid fa-rotate-left"></i> Boshiga qaytish
                </button>
                <div id="step-counter" class="text-xs font-bold px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full">
                    1 / 16
                </div>
            </div>

            <div class="w-full bg-gray-100 h-1.5 rounded-full mb-6 overflow-hidden">
                <div id="progress-bar" class="bg-indigo-500 h-full w-1/16 transition-all duration-300"></div>
            </div>

            <div class="min-h-[220px] flex flex-col justify-center items-center text-center p-4">
                <span id="card-icon" class="text-4xl mb-4 animate-bounce">✨</span>
                <p id="card-text" class="text-lg md:text-xl font-medium text-gray-700 leading-relaxed handwriting">
                </p>
            </div>

            <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-100">
                <button id="prev-btn" onclick="prevCard()" class="px-4 py-2 text-sm font-semibold text-gray-500 hover:text-gray-800 disabled:opacity-30 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Oldingisi
                </button>
                <button id="next-btn" onclick="nextCard()" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition active:scale-95 flex items-center gap-2">
                    <span>Keyingisi</span> <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>

        <div id="comment-screen" class="hidden">
            <div class="text-center mb-6">
                <span class="text-4xl">💌</span>
                <h3 class="text-xl font-bold text-gray-800 mt-2">Yuragingizdagi samimiy so'zlarni yozing</h3>
                <p class="text-xs text-gray-500 mt-1">Siz qoldirgan iliq tilak ushbu saytda saqlanadi va hamma o'qiy oladi!</p>
            </div>

            <form id="comment-form" onsubmit="saveComment(event)" class="space-y-4 mb-8">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Ismingiz / Kimdan:</label>
                    <input type="text" id="author-name" required placeholder="Masalan: Shoxrux (Sobiq shogirdingiz)" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-400 focus:border-transparent outline-none transition text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Iliq tilaklaringiz va dil so'zlaringiz:</label>
                    <textarea id="comment-text" required rows="3" placeholder="Ustoz, bergan ta'limingiz va mehnatlaringiz uchun ming rahmat..." class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-400 focus:border-transparent outline-none transition text-sm"></textarea>
                </div>
                <button type="submit" class="w-full py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition active:scale-98 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> Tilakni saqlash
                </button>
            </form>

            <div class="border-t border-gray-200 pt-6">
                <h4 class="font-bold text-gray-800 text-sm mb-3 flex items-center justify-between">
                    <span>💬 Qoldirilgan barcha tilaklar:</span>
                    <span id="comments-count" class="text-xs bg-gray-100 px-2 py-0.5 rounded-full text-gray-600">0 ta</span>
                </h4>
                <div id="comments-list" class="space-y-3 max-h-60 overflow-y-auto pr-1">
                    <!-- Sharhlar JS orqali yuklanadi -->
                </div>
            </div>
        </div>

    </main>

    <footer class="text-center text-xs text-gray-500 my-4">
        1-Oktabr — "O'qituvchi va murabbiylar kuni"ga bag'ishlab samimiyat bilan tayyorlandi ❤️
    </footer>

    <script>
        const maleGreetings = [
            { icon: "🌟", text: "Muhtaram ustoz! Sayohatimiz boshida sizga bo'lgan cheksiz hurmatimizni izhor etishga ruxsat bergaysiz." },
            { icon: "📖", text: "Siz bizga nafaqat kitobdagi bilimlarni, balki hayotda haqiqiy erkak va inson bo'lib yashash saboqlarini berdingiz." },
            { icon: "💡", text: "Sabringiz va har bir savolimizga bergan erinmas javoblaringiz uchun sizdan bir umr minnatdormiz." },
            { icon: "⚡", text: "Qiyin vaziyatlarda ko'rsatgan qat'iyatingiz va bizga bo'lgan ishonchingiz qalbimizga hamisha kuch bag'ishlaydi." },
            { icon: "🌱", text: "Siz ekkan bilim urug'lari bugun meva bermoqda. Har bir yutug'imiz ortida Sizning behisob mehnatingiz bor." },
            { icon: "📐", text: "Hattoki eng qiyin mavzuni ham shunday tushuntirardingizki, darsingiz tugashini hech xohlamas edik." },
            { icon: "🤝", text: "Siz shunchaki o'qituvchi emas, to'g'ri yo'l ko'rsatuvchi haqiqiy yo'lboshchimiz va murabbiyimizsiz." },
            { icon: "🛡️", text: "Sizdagi mardlik, halollik va adolat tuyg'usi barchamiz uchun haqiqiy o'rnak va namunadir." },
            { icon: "⏳", text: "Vaqt o'tsa ham, sizning sinfxonada aytgan har bir dono va o'rinli maslahatingiz yodimizda jaranglayveradi." },
            { icon: "🎯", text: "Katta maqsadlar sari dadil odimlashni va qiyinchiliklardan qo'rqmaslikni aynan sizdan o'rgandik." },
            { icon: "☕", text: "Charchoqlarga qaramay, har doim tabassum va yuqori kayfiyat bilan kirib kelishingizni sog'inamiz." },
            { icon: "🏆", text: "Biz erishgan har bir muvaffaqiyat va marra sizning tunlari chekkan mehnatingiz mahsulidir." },
            { icon: "🤲", text: "Ilohim, umringiz uzoq, tan-joningiz sog' bo'lsin. Oila a'zolaringiz va shogirdlaringiz baxtiga sog' bo'ling." },
            { icon: "🎉", text: "Bugungi bayramingiz bilan chin qalbimizdan muborakbod etamiz, aziz ustoz!" },
            { icon: "🔥", text: "Siz kabi ustozimiz borligidan har doim faxrlanamiz va g'ururlanamiz!" },
            { icon: "💌", text: "Endi esa, o'z qalbingizdagi tilaklarni quyidagi oynada yozib qoldiring..." }
        ];

        const femaleGreetings = [
            { icon: "🌸", text: "Assalomu alaykum, mehribon va go'zal ustozim! Bayramingiz muborak bo'lsin!" },
            { icon: "🌺", text: "Sizning samimiy tabassumingiz va onalarcha mehringiz sinfxonamizga har doim iliq nur olib kirardi." },
            { icon: "☀️", text: "Har bir o'quvchiga o'z farzandingizdek kuydirganingiz va mehringizni ayamaganingiz uchun rahmat!" },
            { icon: "📚", text: "Sabringiz va bag'rikengligingiz oldida ta'zim qilamiz. Siz bergan saboqlar yuragimizda muhrlangan." },
            { icon: "🌷", text: "Siz bizga nafaqat fanlarni, balki hayotda odobli, shirinso'z va mehribon bo'lishni o'rgatdingiz." },
            { icon: "💖", text: "Sho'xliklarimizni va xatolarimizni tabassum va bosiqlik bilan kechirganingiz uchun minnatdormiz." },
            { icon: "🎨", text: "Sizning darslaringiz har doim qiziqarli, rang-barang va o'zgacha mehr bilan o'tardi." },
            { icon: "✨", text: "Ko'zlaringizdagi ezgulik va bilimga bo'lgan muhabbat bizni har doim yangi marralarga ruhlantirgan." },
            { icon: "🕊️", text: "Qalbimizda doim ezgu xotiralar va sizga bo'lgan cheksiz hurmat saqlanib qoladi." },
            { icon: "🌿", text: "Mashaqqatli va sharafli mehnatingiz rohatini shogirdlaringiz kamarida ko mehnatingiz rohatini ko'ring." },
            { icon: "🎁", text: "Siz dunyodagi eng sabrli, eng bilimli va eng dildosh ustozsiz!" },
            { icon: "🌹", text: "Har bir yutug'imizda sizning shirin so'zingiz va duolaringiz borligini his qilamiz." },
            { icon: "👑", text: "Siz nafaqat ustoz, balki barchamiz uchun haqiqiy onadek qadrli va mo'tabar insonsiz." },
            { icon: "💐", text: "Bugungi bayram kuni sizga uzoq umr, sihat-salomatlik va oilaviy xotirjamlik tilaymiz!" },
            { icon: "❤️", text: "Biz sizni juda ham yaxshi ko'ramiz va xizmatingizni hech qachon unutmaymiz!" },
            { icon: "💌", text: "Endi esa, ustozimizga bo'lgan o'z dil so'zlaringizni yozib qoldirishingiz mumkin..." }
        ];

        let currentGender = null;
        let currentIndex = 0;
        let activeGreetings = [];

        const STORAGE_KEY = "ustozlar_kuni_comments_v1";

        function selectGender(gender) {
            currentGender = gender;
            activeGreetings = gender === 'male' ? maleGreetings : femaleGreetings;
            currentIndex = 0;

            document.getElementById('selection-screen').classList.add('hidden');
            document.getElementById('card-screen').classList.remove('hidden');

            renderCard();
        }

        function renderCard() {
            const card = activeGreetings[currentIndex];
            document.getElementById('card-icon').innerText = card.icon;
            document.getElementById('card-text').innerText = `"${card.text}"`;
            
            const total = activeGreetings.length;
            document.getElementById('step-counter').innerText = `${currentIndex + 1} / ${total}`;
            const percentage = ((currentIndex + 1) / total) * 100;
            document.getElementById('progress-bar').style.width = `${percentage}%`;

            document.getElementById('prev-btn').disabled = currentIndex === 0;

            const nextBtn = document.getElementById('next-btn');
            if (currentIndex === total - 1) {
                nextBtn.innerHTML = `<span>Fikr qoldirish (17-qadam)</span> <i class="fa-solid fa-pen"></i>`;
                nextBtn.className = "px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl font-semibold shadow-md transition active:scale-95 flex items-center gap-2";
            } else {
                nextBtn.innerHTML = `<span>Keyingisi</span> <i class="fa-solid fa-arrow-right"></i>`;
                nextBtn.className = "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition active:scale-95 flex items-center gap-2";
            }
        }

        function nextCard() {
            if (currentIndex < activeGreetings.length - 1) {
                currentIndex++;
                renderCard();
            } else {
                showCommentScreen();
            }
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                renderCard();
            }
        }

        function resetApp() {
            document.getElementById('card-screen').classList.add('hidden');
            document.getElementById('comment-screen').classList.add('hidden');
            document.getElementById('selection-screen').classList.remove('hidden');
            currentIndex = 0;
            currentGender = null;
        }

        function showCommentScreen() {
            document.getElementById('card-screen').classList.add('hidden');
            document.getElementById('comment-screen').classList.remove('hidden');
            loadComments();
        }

        function loadComments() {
            const commentsList = document.getElementById('comments-list');
            const commentsCount = document.getElementById('comments-count');
            
            let comments = [];
            try {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    comments = JSON.parse(stored);
                }
            } catch (e) {
                console.error("Storage error", e);
            }

            if (comments.length === 0) {
                comments = [
                    { name: "Anvarjon (2018-yil bitiruvchisi)", text: "Ustozlarimizga ming rahmat! Barcha yaxshi tilaklaringiz o'zingizga ham hamrohsiz bo'lsin!", date: "26.09.2026" },
                    { name: "Madinabonu", text: "Jonkuyar ayol ustozlarimizga alohida ehtirom. Bayramingiz muborak!", date: "26.09.2026" }
                ];
            }

            commentsCount.innerText = `${comments.length} ta`;

            commentsList.innerHTML = "";
            comments.forEach(c => {
                const item = document.createElement('div');
                item.className = "p-3 bg-gray-50 rounded-xl border border-gray-100 text-xs";
                item.innerHTML = `
                    <div class="flex justify-between items-center font-bold text-gray-700 mb-1">
                        <span>👤 ${escapeHtml(c.name)}</span>
                        <span class="text-[10px] font-normal text-gray-400">${c.date || 'Bugun'}</span>
                    </div>
                    <p class="text-gray-600 leading-relaxed">${escapeHtml(c.text)}</p>
                `;
                commentsList.appendChild(item);
            });
        }

        function saveComment(event) {
            event.preventDefault();

            const nameInput = document.getElementById('author-name');
            const textInput = document.getElementById('comment-text');

            const name = nameInput.value.trim();
            const text = textInput.value.trim();

            if (!name || !text) return;

            const newComment = {
                name: name,
                text: text,
                date: new Date().toLocaleDateString('uz-UZ')
            };

            try {
                let comments = [];
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    comments = JSON.parse(stored);
                }
                comments.unshift(newComment); // Yangisi tepaga
                localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
            } catch (e) {
                console.error("Storage error", e);
            }

            nameInput.value = "";
            textInput.value = "";
            loadComments();

            alert("Iliq tilagingiz muvaffaqiyatli saqlandi! Rahmat ❤️");
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
